{
  "name": "@loamui/docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-css.mjs && node scripts/sync-agent-demo.mjs && tsx --tsconfig scripts/tsconfig.export.json scripts/export-markdown.mts",
    "dev": "node scripts/sync-css.mjs --watch & next dev --port 3007",
    "prebuild": "node scripts/sync-css.mjs && node scripts/sync-agent-demo.mjs && tsx --tsconfig scripts/tsconfig.export.json scripts/export-markdown.mts",
    "build": "next build",
    "start": "next start --port 3007",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json src && stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@loamui/core": "workspace:*",
    "next": "^16.2.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "22.12.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
