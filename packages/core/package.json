{
  "name": "@loamui/core",
  "version": "1.0.0",
  "description": "Modern UI primitives for agent-assisted developers \u2014 contextual tokens, element styles and React components on native modern CSS.",
  "keywords": [
    "a11y",
    "accessible",
    "agent-assisted",
    "component-library",
    "components",
    "contextual",
    "css",
    "dark-mode",
    "design-system",
    "modern-css",
    "primitives",
    "react",
    "tokens",
    "ui",
    "ui-primitives",
    "zero-runtime"
  ],
  "homepage": "https://loamui.com/",
  "bugs": {
    "url": "https://github.com/dangerfarms/loamui/issues"
  },
  "license": "MIT",
  "author": "Danger Farms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangerfarms/loamui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "node scripts/build-css.mjs --watch & tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json src && stylelint \"src/**/*.css\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix src && stylelint \"src/**/*.css\" --fix",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "audit:contrast": "node scripts/contrast-audit.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.4.2",
    "tsup": "^8.5.0",
    "typescript": "5.9.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
